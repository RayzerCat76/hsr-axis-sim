{
  "id": "constrained_search_mvp",
  "name": "Constrained Search MVP",
  "description": "Small offline search scenario proving target constraints filter generated legal choices.",
  "characters_dir": "../sample_characters",
  "team_path": "../sample_teams/bronya_seele_team.json",
  "search": {
    "max_depth": 2,
    "beam_width": 3,
    "profile": "generic_kill",
    "include_ultimates": false,
    "max_global_av": null,
    "max_nodes_expanded": 100,
    "constraints": {
      "allowed_actor_ids": ["seele_like", "bronya_like"],
      "disabled_target_ids": ["enemy_2"],
      "max_choices_per_node": 4
    }
  },
  "report": {
    "format": "markdown",
    "top_k": 5
  }
}
